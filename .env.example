# Client-Safe Public Configuration (.env)
# Only public URLs and anonymous/client keys belong here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# SERVER-SIDE SECRETS:
# DO NOT place SUPABASE_SERVICE_ROLE_KEY, MUX_TOKEN_SECRET, CLOUDINARY_API_SECRET,
# or IMAGEKIT_PRIVATE_KEY in this file.
# Server secrets belong in `supabase/.env.local` for local development or in Supabase Secrets vault.
